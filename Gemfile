source "https://rubygems.org"

# Site generator. The site predates Bundler (source lived in jekyll/ and was
# built by a docker jekyll/jekyll image), so this pins the modern equivalent.
gem "jekyll", "~> 4.3"

# Ruby 3.x removed webrick from the stdlib; `jekyll serve` needs it.
gem "webrick", "~> 1.8"
